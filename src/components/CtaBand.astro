---
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
}

const {
  eyebrow = "Next conversation",
  title = "Ready to tighten the operation?",
  body = "Bring the fleet, the plant, or the workshop. We will tell you what is worth changing first.",
} = Astro.props;
---

<section class="section section--navy">
  <div class="wrap cta-band">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="lead" style="margin-top: 1rem; max-width: 34rem">{body}</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem">
      <a class="btn btn--on-dark" href="/contact">
        <Icon name="consult" />
        Book a consultation
      </a>
      <a class="btn btn--ghost-on-dark" href="tel:+254728764014">
        <Icon name="phone" />
        Call +254 728 764 014
      </a>
    </div>
  </div>
</section>
