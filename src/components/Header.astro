---
import { primaryNav, site } from "../content/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/images/Company%20Logo.png" alt="" width="42" height="42" />
      <span class="brand-name">{site.legalName}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle aria-label="Open menu">
      <span></span>
    </button>
    <nav class="nav" id="site-nav" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <div class="nav-item">
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
            {item.children && (
              <div class="nav-sub">
                {item.children.map((child) => (
                  <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined}>
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
      <a class="btn btn--primary" href="/contact">Book a consultation</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("#site-header");
  const toggle = document.querySelector("[data-menu-toggle]");
  if (header && toggle instanceof HTMLButtonElement) {
    toggle.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
  }
</script>
