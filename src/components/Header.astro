---
import { primaryNav, site } from "../content/site";
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/images/Company%20Logo.png" alt="" width="42" height="42" />
      <span class="brand-name">{site.legalName}</span>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
      aria-label="Open menu"
    >
      <Icon name="menu" class="menu-toggle__open" />
      <Icon name="close" class="menu-toggle__close" />
    </button>
    <nav class="nav" id="site-nav" aria-label="Primary">
      <p class="nav-kicker">Index</p>
      <div class="nav-list">
        {
          primaryNav.map((item, index) => (
            <div class="nav-item">
              <a
                class="nav-link"
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                <span class="nav-num">{String(index + 1).padStart(2, "0")}</span>
                <span class="nav-icon">
                  <Icon name={item.icon} />
                </span>
                <span class="nav-label">{item.label}</span>
              </a>
              {item.children && (
                <div class="nav-sub">
                  {item.children.map((child) => (
                    <a
                      class="nav-link nav-link--sub"
                      href={child.href}
                      aria-current={isCurrent(child.href) ? "page" : undefined}
                    >
                      <span class="nav-icon">
                        <Icon name={child.icon} />
                      </span>
                      <span class="nav-label">{child.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
      <div class="nav-cta-block">
        <a class="btn btn--primary nav-cta" href="/contact">
          <Icon name="consult" />
          Book a consultation
        </a>
        <div class="nav-reach">
          <a href={site.phones[0].href}>
            <Icon name="phone" />
            {site.phones[0].label}
          </a>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" />
            {site.email}
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector("#site-header");
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("#site-nav");

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement && nav instanceof HTMLElement) {
    const media = window.matchMedia("(max-width: 860px)");

    const setOpen = (open: boolean) => {
      header.classList.toggle("is-open", open);
      document.body.classList.toggle("is-nav-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      nav.setAttribute("aria-hidden", media.matches ? String(!open) : "false");
    };

    toggle.addEventListener("click", () => {
      setOpen(!header.classList.contains("is-open"));
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (media.matches) setOpen(false);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    media.addEventListener("change", (event) => {
      if (!event.matches) setOpen(false);
    });

    setOpen(false);
  }
</script>
