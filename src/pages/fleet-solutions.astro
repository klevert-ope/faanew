---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
---

<Base
  title="Fleet solutions"
  description="Fleet transformation, consultancy, and training for organisations operating across Africa."
  image="/images/fleet.jpg"
>
  <section class="page-hero">
    <div class="wrap split split--start">
      <div>
        <span class="eyebrow">Fleet</span>
        <h1>Large-scale fleet programmes, designed to be run.</h1>
      </div>
      <p class="lead">
        Transformation, digitisation, workshops, and the human system around the vehicles. We design for cost, uptime,
        and safety in hard operating environments.
      </p>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="wrap split">
      <figure class="media-frame">
        <img src="/images/project_mgt.jpg" alt="Fleet project delivery" />
      </figure>
      <div>
        <h2>Project management</h2>
        <ul class="list">
          <li>
            <strong>Transformation programmes</strong>
            Engineering-led design that modernises performance without theatre.
          </li>
          <li>
            <strong>Workshop development</strong>
            Layout, tooling, and process that shorten turnaround.
          </li>
          <li>
            <strong>Digitisation</strong>
            CMMS, telematics, and fuel systems that give a real picture of the fleet.
          </li>
          <li>
            <strong>Electric and green transition</strong>
            Feasibility, infrastructure, and cleaner energy where it pays.
          </li>
          <li>
            <strong>Driver safety</strong>
            Training, monitoring, and compliance that reduce risk on the road.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Consultancy</h2>
        <ul class="list">
          <li>
            <strong>Operational audits</strong>
            Performance, waste, and a short list of changes that matter.
          </li>
          <li>
            <strong>Maintenance system design</strong>
            Lifecycle management that keeps assets reliable.
          </li>
          <li>
            <strong>Tyre and fuel programmes</strong>
            Accountability, tracking, and less leakage.
          </li>
          <li>
            <strong>Transport cost optimisation</strong>
            Routes, utilisation, and productivity, measured.
          </li>
        </ul>
      </div>
      <figure class="media-frame">
        <img src="/images/fleet.png" alt="Fleet operations" />
      </figure>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="wrap split">
      <figure class="media-frame">
        <img src="/images/training.png" alt="Fleet training" />
      </figure>
      <div>
        <h2>Training</h2>
        <ul class="list">
          <li>
            <strong>Drivers</strong>
            Practical skill, safety, and responsible road behaviour.
          </li>
          <li>
            <strong>Fleet managers</strong>
            Oversight, cost, and performance tools they will use.
          </li>
          <li>
            <strong>Technicians and workshops</strong>
            Maintenance quality and efficient bay work.
          </li>
          <li>
            <strong>EV technicians</strong>
            Systems, safety, and the transition to electric mobility.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
