---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
---

<Base
  title="Industrial solutions"
  description="Industrial project delivery, consultancy, and training from concept to completion."
  image="/images/factory.png"
>
  <section class="page-hero">
    <div class="wrap split split--start">
      <div>
        <span class="eyebrow">Industrial</span>
        <h1>Engineering programmes from concept to a plant that stays up.</h1>
      </div>
      <p class="lead">
        Facilities, manufacturing systems, maintenance strategy, and the training that keeps industrial capability on
        site after we leave.
      </p>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="wrap split">
      <figure class="media-frame">
        <img src="/images/factory.png" alt="Industrial facility" />
      </figure>
      <div>
        <h2>Project management</h2>
        <ul class="list">
          <li>
            <strong>Facilities and modernisation</strong>
            Design, build, and upgrade to current operational standards.
          </li>
          <li>
            <strong>Manufacturing system setup</strong>
            Process, workflow, and layout that raise output quality.
          </li>
          <li>
            <strong>Equipment installation</strong>
            Commissioning that integrates cleanly into the line.
          </li>
          <li>
            <strong>Maintenance system implementation</strong>
            Reliability, less downtime, asset history that can be trusted.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Consultancy</h2>
        <ul class="list">
          <li>
            <strong>Asset management</strong>
            Value, performance, and a longer useful life.
          </li>
          <li>
            <strong>Maintenance strategy</strong>
            Reliability plans aligned to how the plant actually runs.
          </li>
          <li>
            <strong>Spare-parts inventory</strong>
            Availability without bloated stores.
          </li>
          <li>
            <strong>Operational efficiency</strong>
            Waste out. Process in. Measured.
          </li>
        </ul>
      </div>
      <figure class="media-frame">
        <img src="/images/workshop.jpg" alt="Industrial workshop" />
      </figure>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="wrap">
      <span class="eyebrow">Capacity</span>
      <h2>Industrial training</h2>
      <p class="lead" style="max-width: 36rem; margin-bottom: 2rem">
        Technical skill, planning discipline, and a safety culture that holds under pressure.
      </p>
      <div class="grid-2">
        <article class="card">
          <h3>Maintenance management</h3>
          <p>Planning, scheduling, and supervision that raise reliability.</p>
        </article>
        <article class="card">
          <h3>Technical skills</h3>
          <p>Tools, machinery, and process proficiency on the current kit.</p>
        </article>
        <article class="card">
          <h3>Engineering programmes</h3>
          <p>Design, operations, and problem-solving for plant teams.</p>
        </article>
        <article class="card">
          <h3>Industrial safety</h3>
          <p>Hazard recognition and accident-free operating habit.</p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
