---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../content/site";
---

<Base
  title="Contact"
  description="Book a consultation with Fleet Associates Africa. Nairobi studio, regional delivery."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Tell us what the operation needs.</h1>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap contact-panel">
      <div>
        <div class="contact-detail">
          <span>Call</span>
          {site.phones.map((phone) => (
            <a href={phone.href}>
              <Icon name="phone" />
              {phone.label}
            </a>
          ))}
        </div>
        <div class="contact-detail">
          <span>Email</span>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" />
            {site.email}
          </a>
        </div>
        <div class="contact-detail">
          <span>Studio</span>
          <p>{site.address}</p>
        </div>
        <div class="contact-detail">
          <span>Post</span>
          <p>{site.poBox}</p>
        </div>
      </div>

      <form class="form card" method="get" action={`mailto:${site.email}`} enctype="text/plain">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="message">What should we look at?</label>
          <textarea id="message" name="body" required></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Send enquiry</button>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector("form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    const data = new FormData(form);
    const name = String(data.get("name") ?? "");
    const email = String(data.get("email") ?? "");
    const phone = String(data.get("phone") ?? "");
    const body = String(data.get("body") ?? "");
    const subject = encodeURIComponent(`Consultation request from ${name}`);
    const composed = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nPhone: ${phone}\n\n${body}`);
    window.location.href = `mailto:info@faaafrica.com?subject=${subject}&body=${composed}`;
  });
</script>
